{
  "name": "@system-ui-js/file-system-browser-workspace",
  "version": "0.1.0",
  "description": "A WebDAV-like file system interface using IndexedDB for browser-based file storage",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.demo.config.ts --port 9973",
    "build": "yarn workspaces run build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview": "vite preview",
    "lint": "yarn workspaces run lint",
    "lint:fix": "yarn workspaces run lint:fix",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,json,css,html}\"",
    "pack": "mkdir -p dist-packages && yarn workspaces run pack:workspace",
    "pack:all": "mkdir -p dist-packages && yarn workspaces run pack:workspace",
    "test:e2e": "vite --config vite.demo.config.ts --port 9974 & SERVER_PID=$!; sleep 3; npx playwright test --reporter=list; STATUS=$?; kill $SERVER_PID; exit $STATUS",
    "test:e2e:ui": "vite --config vite.demo.config.ts --port 9974 & SERVER_PID=$!; sleep 3; npx playwright test --ui; STATUS=$?; kill $SERVER_PID; exit $STATUS",
    "test:unit": "vitest --config vitest.config.ts"
  },
  "keywords": [
    "webdav",
    "indexeddb",
    "file-system",
    "browser",
    "storage"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/system-ui-js/file-system.git"
  },
  "bugs": {
    "url": "https://github.com/system-ui-js/file-system/issues"
  },
  "homepage": "https://github.com/system-ui-js/file-system#readme",
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
